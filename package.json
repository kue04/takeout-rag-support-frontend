{
  "name": "takeout-rag-support-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "types:api": "node scripts/sync-openapi.mjs && openapi-typescript openapi/openapi.json -o src/types/openapi.generated.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run types:api && npm run test && npm run build"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "vitest": "^4.1.10"
  }
}
